{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/Vihanga-Chamodya-Kumanayaka-CV-:hash.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Vihanga Chamodya Kumanayaka - CV.pdf\""
        }
      ]
    }
  ]
}